# ============================================================
# Environment Configuration Template
# Copy to .env and fill in your API keys:  cp .env.example .env
# ============================================================

# ── LLM Configuration ───────────────────────────────────────
# The server uses Google Gemini by default with a $5/month budget
# per company.  Users can add their own API key in Settings > AI
# Configuration for unlimited access.

# Google Gemini (primary)
# GOOGLE_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI (optional — fallback provider)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_PROD_MODEL=gpt-4o

# Anthropic (optional — for multi-provider BYOK validation)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# DeepSeek (optional)
# DEEPSEEK_API_KEY=your-key-here

# Mistral (optional)
# MISTRAL_API_KEY=your-key-here

# ── Ollama / Local LLM ─────────────────────────────────────
# For local AI or DGX server.  Users can also configure per-company
# endpoints in Settings > AI Configuration.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:70b

# ── Default Model ───────────────────────────────────────────
# DEFAULT_LLM_MODEL=gemini-2.5-flash

# ── LLM Key Encryption ─────────────────────────────────────
# Required in production.  Encrypts user-provided API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LLM_KEY_ENCRYPTION_KEY=

# ── Database ────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379/0

# ── Authentication ──────────────────────────────────────────
# JWT_SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# ── Application ─────────────────────────────────────────────
# APP_ENV=development
# DEBUG=true
# LOG_LEVEL=INFO
