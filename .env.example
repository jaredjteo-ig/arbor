# ============================================================
# HR AI Advisory Platform — Environment Configuration
# Copy to .env and fill in your API keys:  cp .env.example .env
# ============================================================

# ── LLM Configuration ───────────────────────────────────────
# At minimum, configure ONE provider with its API key and model.

# OpenAI
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_PROD_MODEL=gpt-4o
# OPENAI_DEV_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google (Gemini)
# GOOGLE_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here

# DeepSeek
# DEEPSEEK_API_KEY=your-key-here

# Mistral
# MISTRAL_API_KEY=your-key-here

# Perplexity
# PERPLEXITY_API_KEY=pplx-your-key-here

# ── Default Model ───────────────────────────────────────────
# Fallback model used when no specific model is configured.
# DEFAULT_LLM_MODEL=gpt-4o

# ── Database ────────────────────────────────────────────────
# Set these to real values for your environment.
# DATABASE_URL=postgresql://user:password@localhost:5432/arbor
# REDIS_URL=redis://localhost:6379/0

# ── Authentication ──────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=your-secure-random-secret-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_MINUTES=60

# Google OAuth2 (for social login)
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8099/auth/google/callback

# ── Email (SendGrid) ─────────────────────────────────────────
# SENDGRID_API_KEY=SG.your-key-here
# FROM_EMAIL=noreply@arbor.sg

# ── Application ─────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
