# Arbor Production Environment — copy to .env.prod and fill in real values

# Database
DATABASE_URL=postgresql://arbor:CHANGE_ME@postgres:5432/arbor
POSTGRES_USER=arbor
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=arbor

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# Auth
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_-c_"import secrets; print(secrets.token_urlsafe(64))"

# LLM — Server default key (optional, users can bring their own in Settings)
GOOGLE_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_LLM_MODEL=gemini-2.5-flash

# LLM Key Encryption — REQUIRED for BYOK feature
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_KEY=CHANGE_ME

# Optional: Ollama / DGX endpoint
# OLLAMA_BASE_URL=http://dgx.institution.edu:11434
# OLLAMA_MODEL=llama3.1:70b

# Optional: Anthropic
# ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Google OAuth2 (for social login)
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://central.kailash.ai/auth/callback

# App
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://central.kailash.ai
