# AITE Production Environment — copy to .env.prod and fill in real values

# Database
DATABASE_URL=postgresql://aite:CHANGE_ME@postgres:5432/aite
POSTGRES_USER=aite
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aite

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# Auth
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_-c_"import secrets; print(secrets.token_urlsafe(64))"

# LLM
OPENAI_API_KEY=sk-CHANGE_ME
DEFAULT_LLM_MODEL=gpt-4o

# Optional: Anthropic
# ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Google OAuth2 (for social login)
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://aite.kailash.ai/auth/callback

# App
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://aite.kailash.ai
