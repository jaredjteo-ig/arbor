# ============================================================
# Arbor Production Environment Template
# ============================================================
#
# Usage:
#   1. Copy this file to .env in your deploy directory:
#      cp .env.production.template .env
#
#   2. Replace ALL "changeme_XXX" placeholders with real values.
#      Generate secrets with these commands:
#
#      JWT secret:
#        python -c "import secrets; print(secrets.token_urlsafe(64))"
#
#      Fernet encryption keys:
#        python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
#      Postgres password:
#        openssl rand -base64 32
#
#      Redis password:
#        openssl rand -base64 32
#
#   3. Deploy with docker-compose.prod.yml:
#      scp docker-compose.prod.yml Caddyfile .env arbor-prod:~/arbor/
#      ssh arbor-prod "cd ~/arbor && docker compose -f docker-compose.prod.yml pull && docker compose -f docker-compose.prod.yml up -d"
#
# IMPORTANT: Never commit this file with real values to version control.
# ============================================================

# ── Versioning ──────────────────────────────────────────────
# Docker image tag for arbor-backend and arbor-frontend.
# Use a specific version for reproducible deploys; "latest" for rolling.
ARBOR_VERSION=latest

# ── Application ─────────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
KAILASH_RUNTIME=async

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=https://arbor.terrene.foundation

# Frontend URL used for invitation links and email callbacks.
FRONTEND_URL=https://arbor.terrene.foundation

# ── Database (PostgreSQL 16 + pgvector) ─────────────────────
# Credentials for the postgres container.
POSTGRES_USER=arbor
POSTGRES_PASSWORD=changeme_POSTGRES_PASSWORD
POSTGRES_DB=arbor

# Full connection string used by the backend.
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql://arbor:changeme_POSTGRES_PASSWORD@postgres:5432/arbor

# DataFlow connection pool size per worker.
# Formula: postgres max_connections / num_workers * 0.7
# For a single-worker setup on a small instance (max_connections ~150): 30 is safe.
# See .claude/rules/connection-pool.md for sizing guidance.
DATAFLOW_MAX_CONNECTIONS=30

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=changeme_REDIS_PASSWORD
REDIS_URL=redis://:changeme_REDIS_PASSWORD@redis:6379/0

# ── Authentication (JWT) ────────────────────────────────────
# REQUIRED. The app refuses to start in production with the default value.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme_JWT_SECRET

# JWT signing algorithm (HS256 is the default and recommended).
JWT_ALGORITHM=HS256

# Token lifetime in minutes (default: 60).
JWT_EXPIRY_MINUTES=60

# ── Google OAuth (optional) ─────────────────────────────────
# Leave blank to disable Google Sign-In.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# IMPORTANT: This must match the frontend callback page URL, NOT the backend API.
# The frontend at /auth/callback receives the code from Google, validates
# the CSRF state, then calls POST /auth/google/exchange on the backend.
GOOGLE_OAUTH_REDIRECT_URI=https://arbor.terrene.foundation/auth/callback

# ── Encryption ──────────────────────────────────────────────
# Fernet key for encrypting salary and PII fields at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SALARY_ENCRYPTION_KEY=changeme_SALARY_ENCRYPTION_KEY

# Fernet key for encrypting user-provided LLM API keys at rest.
# Uses a SEPARATE key from SALARY_ENCRYPTION_KEY to avoid single-point-of-compromise.
# REQUIRED in production (no plaintext fallback).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_KEY=changeme_LLM_KEY_ENCRYPTION_KEY

# ── LLM Configuration ──────────────────────────────────────
# Server-level OpenAI key (optional). Provides a default AI service
# with a $5/month budget per company. Users can bring their own key
# via Settings > AI Configuration for unlimited access.
OPENAI_API_KEY=changeme_OPENAI_API_KEY

# Production and development model names. These MUST match a model
# your API key has access to. Do NOT hardcode model names in code.
OPENAI_PROD_MODEL=gpt-5-mini-2025-08-07
DEFAULT_LLM_MODEL=gpt-5-mini-2025-08-07

# Anthropic (optional -- for multi-provider BYOK validation).
ANTHROPIC_API_KEY=

# ── Email (optional) ────────────────────────────────────────
# Leave blank to disable outbound email (invitations, notifications).
SENDGRID_API_KEY=
FROM_EMAIL=noreply@arbor.sg

# ── Frontend ────────────────────────────────────────────────
# Public API URL that the Next.js frontend calls.
# Set automatically in docker-compose.prod.yml; override here if needed.
# NEXT_PUBLIC_API_URL=https://arbor.terrene.foundation/api

# Google OAuth client ID for the frontend (must match GOOGLE_OAUTH_CLIENT_ID).
# Required for the "Sign in with Google" button to appear.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
