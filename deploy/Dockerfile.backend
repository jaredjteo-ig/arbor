FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl build-essential && \
    rm -rf /var/lib/apt/lists/*

# Copy everything needed for install
COPY pyproject.toml README.md ./
COPY src/ ./src/

# Install Python dependencies
# Kailash SDK is enterprise — install direct deps as fallback for open-source builds
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
      fastapi>=0.110.0 uvicorn>=0.29.0 pydantic>=2.7.0 \
      sqlalchemy>=2.0.0 psycopg2-binary>=2.9.9 \
      python-dotenv>=1.0.0 structlog>=23.1.0 \
      PyJWT>=2.8.0 bcrypt>=4.0.0 \
      openai>=1.30.0 httpx>=0.27.0 \
      cryptography>=42.0.0 pgvector>=0.3.0 psutil>=5.9.0 \
      requests>=2.31.0 pandas>=2.0.0 numpy>=1.24.0 \
      jinja2>=3.1.0 aiohttp>=3.9.0 websockets>=12.0 \
      python-docx>=1.1.0 sendgrid>=6.11.0 \
      click>=8.0 rich>=13.0.0 alembic>=1.12.0 && \
    pip install --no-cache-dir . 2>/dev/null || \
    echo "Note: Kailash SDK not available — using direct dependencies"

# Non-root user
RUN useradd --create-home appuser
USER appuser

EXPOSE 8000

# PYTHONPATH must include src/ so imports resolve
ENV PYTHONPATH=/app/src
# Use AsyncLocalRuntime in containers (REQUIRED — LocalRuntime hangs)
ENV KAILASH_RUNTIME=async
ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "hr_advisory.api.server"]
