FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl build-essential && \
    rm -rf /var/lib/apt/lists/*

# Copy everything needed for install
COPY pyproject.toml README.md ./
COPY src/ ./src/

# Install Python dependencies
# Pre-install all transitive deps so Kailash SDK imports resolve at build time
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
      # --- Kailash Core SDK deps ---
      fastapi uvicorn pydantic sqlalchemy httpx psutil requests \
      pandas numpy aiohttp aiohttp-cors websockets aiofiles \
      jsonschema matplotlib plotly prometheus-client networkx \
      msal mcp pyotp qrcode redis scikit-learn scipy twilio \
      pyyaml click bcrypt PyJWT Pillow \
      # --- Kailash DataFlow deps ---
      alembic asyncpg aiomysql aiosqlite dnspython motor pymongo \
      # --- Kailash Kaizen deps ---
      typing-extensions \
      # --- Arbor app deps ---
      python-dotenv structlog openai cryptography pgvector \
      psycopg2-binary python-docx sendgrid rich reportlab \
      python-multipart email-validator tiktoken tenacity jinja2 && \
    pip install --no-cache-dir .

# Non-root user
RUN useradd --create-home appuser
USER appuser

EXPOSE 8000

# PYTHONPATH must include src/ so imports resolve
ENV PYTHONPATH=/app/src
# Use AsyncLocalRuntime in containers (REQUIRED — LocalRuntime hangs)
ENV KAILASH_RUNTIME=async
ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "hr_advisory.api.server"]
